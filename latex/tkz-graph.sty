%<--------------------------------------------------------------------------->
% \Vertices[options]{form}{list} ; form : line, square, tr1, tr2, tr3, tr4,
% circle ; each form is the macro \tkzgr@vertices@<form>
\newcommand*{\tkzgr@Vertices}[1][]{\tkzgr@vertices@nostar[#1]}%
\def\tkzgr@vertices@nostar[#1]#2#3{%
\tkzgr@setkeys{vertex}{#1}%
\begingroup%
   \setcounter{tkz@gr@p}{0}%
   \@for\tkzgr@liste:=#3\do{%
     \stepcounter{tkz@gr@p}%
     \global\expandafter\let\csname label@\alph{tkz@gr@p}\endcsname
                                \tkzgr@liste}%
   \@ifundefined{tkzgr@vertices@#2}%
     {\PackageWarning{tkz-graph}{Unknown form `#2' for \string\Vertices}}%
     {\csname tkzgr@vertices@#2\endcsname{#1}{#3}}%
\endgroup%
}
\def\tkzgr@vertices@line#1#2{%
   \setcounter{tkz@gr@p}{0}%
   \foreach \tkzgr@fin in {#2}{%
       \ifnum\value{tkz@gr@p}=0
       \global\let\tkzgr@deb\tkzgr@fin
       \tkzgr@Vertex[#1]{\tkzgr@fin}
       \stepcounter{tkz@gr@p}
       \else
       \cmdGR@vertex@dir[#1,x={},y={},a={},d={},Node=false]%
                        (\tkzgr@deb){\tkzgr@fin}
       \global\let\tkzgr@deb\tkzgr@fin
       \fi
     }}
\def\tkzgr@vertices@square#1#2{%
     \begin{scope}[rotate=45]
       \tkzgr@Vertex[#1,Lpos=-135]{\label@a}
        \tkzgr@EA[#1,Lpos=-45,x={},y={},Node=false](\label@a){\label@b}
        \tkzgr@NO[#1,Lpos=45, x={},y={},Node=false](\label@b){\label@c}
        \tkzgr@WE[#1,Lpos=135,x={},y={},Node=false](\label@c){\label@d}
     \end{scope}}
\def\tkzgr@vertices@tri#1#2#3{%
     \tkzgr@Vertex[#1]{\label@a}
     #2[#1,x={},y={},Node=false](\label@a){\label@b}
     #3[#1,x={},y={},Node=false](\label@b){\label@c}}
\def\tkzgr@vertices@trI#1#2{\tkzgr@vertices@tri{#1}\tkzgr@EA\tkzgr@NO}
\def\tkzgr@vertices@trII#1#2{\tkzgr@vertices@tri{#1}\tkzgr@NO\tkzgr@EA}
\def\tkzgr@vertices@trIII#1#2{\tkzgr@vertices@tri{#1}\tkzgr@NO\tkzgr@WE}
\def\tkzgr@vertices@trIV#1#2{\tkzgr@vertices@tri{#1}\tkzgr@WE\tkzgr@NO}
\expandafter\let\csname tkzgr@vertices@tr1\endcsname\tkzgr@vertices@trI
\expandafter\let\csname tkzgr@vertices@tr2\endcsname\tkzgr@vertices@trII
\expandafter\let\csname tkzgr@vertices@tr3\endcsname\tkzgr@vertices@trIII
\expandafter\let\csname tkzgr@vertices@tr4\endcsname\tkzgr@vertices@trIV
% keys rotation (angle of the first vertex) and clockwise
\def\tkzgr@turn{%
  \ifGR@vertex@clockwise
    \pgfmathparse{\cmdGR@vertex@rotation-\tkzgr@newangle}%
    \let\tkzgr@newangle\pgfmathresult
  \else
    \pgfmathparse{\cmdGR@vertex@rotation}%
    \ifdim\pgfmathresult pt=\z@\else
      \pgfmathparse{\cmdGR@vertex@rotation+\tkzgr@newangle}%
      \let\tkzgr@newangle\pgfmathresult
    \fi
  \fi}
\def\tkzgr@vertices@circle#1#2{%
    \pgfmathdivide{360}{\value{tkz@gr@p}}%
    \global\let\tkzgr@angle\pgfmathresult%
    \setcounter{tkz@gr@p}{0}%
    \foreach \tkzgr@lab in {#2}{%
      \pgfmathmultiply{\tkzgr@angle}{\thetkz@gr@p}%
      \let\tkzgr@newangle\pgfmathresult%
      \tkzgr@turn
      \pgfmathadd{\cmdGR@vertex@Lpos}{\tkzgr@newangle}%
      \let\tkzgr@posangle\pgfmathresult%
        \tkzgr@Vertex[#1,
              a    = \tkzgr@newangle,
              d    = \cmdGR@vertex@unit,
              Lpos = \tkzgr@posangle]{\tkzgr@lab}
          \stepcounter{tkz@gr@p}%
      }}
