\newcommand*{\grProb}[7][]{%
\tkzgr@setkeys{grpb}{#1}%
\tikzset{LabelStyle/.append style ={pos=.5}}
\tkzgr@Vertex[Lpos=\cmdGR@grpb@LposA,Ldist=\cmdGR@grpb@Ldist,L=#2]{grA}
\tkzgr@EA[unit=\cmdGR@grpb@unit,Lpos=\cmdGR@grpb@LposB,
    Ldist=\cmdGR@grpb@Ldist,L=#3](grA){grB}
\tkzgr@Edge[style={post,bend left=60},label={$#4$},labelstyle={above}](grA)(grB)
\tkzgr@Edge[style={post,bend left=60},label={$#5$},labelstyle={below}](grB)(grA)
\tkzgr@Loop[dist=\cmdGR@grpb@LoopDist,dir=WE,label={$#6$},labelstyle={left}](grA)
\tkzgr@Loop[dist=\cmdGR@grpb@LoopDist,dir=EA,label={$#7$},labelstyle={right}](grB)
}%
\newcommand*{\grProbThree}[7][]{%
\tkzgr@setkeys{grpb}{#1}%
\begin{scope}[]
  \tikzset{LabelStyle/.append style ={pos=.5}}
  \tkzgr@Vertices[empty,unit=\cmdGR@grpb@unit]{circle}{grA,grB,grC}
   \tkzgr@Vertex[Node,Lpos=\cmdGR@grpb@LposA,Ldist=\cmdGR@grpb@Ldist,L=#2]{grA}
   \tkzgr@Vertex[Node,Lpos=\cmdGR@grpb@LposA,Ldist=\cmdGR@grpb@Ldist,L=#3]{grB}
   \tkzgr@Vertex[Node,Lpos=\cmdGR@grpb@LposA,Ldist=\cmdGR@grpb@Ldist,L=#4]{grC}
   \foreach \tkzgr@x/\tkzgr@y/\tkzgr@z in {#5} {%
   \tkzgr@Loop[dist=\cmdGR@grpb@LoopDist,dir=EA,label={$\tkzgr@x$}](grA)
\tkzgr@Edge[style={post,bend right=20},label={$\tkzgr@y$}](grA)(grB)
\tkzgr@Edge[style={post,bend right=20},label={$\tkzgr@z$}](grA)(grC)}
\foreach \tkzgr@x/\tkzgr@y/\tkzgr@z in {#6} {%
   \tkzgr@Loop[dist=\cmdGR@grpb@LoopDist,dir=NO,label={$\tkzgr@x$}](grB)
\tkzgr@Edge[style={post,bend right=20},label={$\tkzgr@y$}](grB)(grA)
\tkzgr@Edge[style={post,bend right=20},label={$\tkzgr@z$}](grB)(grC)}
   \foreach \tkzgr@x/\tkzgr@y/\tkzgr@z in {#7} {%
   \tkzgr@Loop[dist=\cmdGR@grpb@LoopDist,dir=SO,label={$\tkzgr@x$}](grC)
 \tkzgr@Edge[style={post,bend right=20},label={$\tkzgr@y$}](grC)(grA)
 \tkzgr@Edge[style={post,bend right=20},label={$\tkzgr@z$}](grC)(grB)}
\end{scope}
}
