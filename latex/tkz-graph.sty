  \renewcommand*{\EdgeDoubleDistance}{2pt}%
  \renewcommand*{\EdgeLineWidth}{0.7pt}%
  \SetGraphShadeColor{#1}{#2}{#3}
}%

\newcommand{\setxyzvec}[1][20]{%
  \pgfmathsetmacro{\xone}{cos(180+#1)}%
  \pgfmathsetmacro{\yone}{sin(180+#1)}%
  \pgfmathsetmacro{\xtwo}{cos(360-#1)}%
  \pgfmathsetmacro{\ytwo}{sin(360-#1)}%
  \pgfsetxvec{\pgfpoint{\xone cm}{\yone cm}}%
  \pgfsetyvec{\pgfpoint{\xtwo cm}{\ytwo cm}}%
  \pgfsetzvec{\pgfpoint{0cm}{1cm}}%
}
%<--------------------------------------------------------------------------->
%                    \tkzSetUpGraph : global settings
%<--------------------------------------------------------------------------->
% Each key changes one of the macros \Vertex..., \Edge..., \Label...,
% \GraphUnit (the old way was \renewcommand). The changes are local :
% inside a group or a tikzpicture they stop at the end of it.
% directed : every edge gets an arrow (key -> of \Edge) ; directed=false
% cancels it. arrow tip : the tip used by the keys ->, <-, <-> of \Edge
% (stealth' by default ; for the tips Stealth, Latex ... load the
% library arrows.meta : it is not loaded by tkz-graph because it changes
% slightly the default tip "to").
\def\tkzgr@arrowtip{stealth'}
\def\tkzgr@true{true}
\def\tkzgr@directed#1{%
  \edef\tkzgr@tmpd{#1}%
  \ifx\tkzgr@tmpd\tkzgr@true
    \tkzgr@presetkeys{edge}{arrow = ->}%
  \else
    \tkzgr@presetkeys{edge}{arrow = {}}%
  \fi}
\pgfkeys{/tkzgraph/setup/.cd,
  vertex shape/.code         = {\def\VertexShape{#1}},
  vertex line width/.code    = {\def\VertexLineWidth{#1}},
  vertex line color/.code    = {\def\VertexLineColor{#1}},
  vertex text color/.code    = {\def\VertexTextColor{#1}},
  vertex fill/.code          = {\def\VertexFillColor{#1}},
  light fill/.code           = {\def\VertexLightFillColor{#1}},
  dark fill/.code            = {\def\VertexDarkFillColor{#1}},
  ball color/.code           = {\def\VertexBallColor{#1}},
  inner sep/.code            = {\def\VertexInnerSep{#1}},
  outer sep/.code            = {\def\VertexOuterSep{#1}},
  small size/.code           = {\def\VertexSmallMinSize{#1}},
  medium size/.code          = {\def\VertexInterMinSize{#1}},
  big size/.code             = {\def\VertexBigMinSize{#1}},
  edge color/.code           = {\def\EdgeColor{#1}},
  edge width/.code           = {\def\EdgeLineWidth{#1}},
  edge fill/.code            = {\def\EdgeFillColor{#1}},
  art color/.code            = {\def\EdgeArtColor{#1}},
  double distance/.code      = {\def\EdgeDoubleDistance{#1}},
  label text/.code           = {\def\LabelTextColor{#1}},
  label fill/.code           = {\def\LabelFillColor{#1}},
  unit/.code                 = {\def\GraphUnit{#1}},
  directed/.code             = {\tkzgr@directed{#1}},
  directed/.default          = true,
  arrow tip/.code            = {\def\tkzgr@arrowtip{#1}}}
\newcommand*{\tkzSetUpGraph}[1][]{\pgfqkeys{/tkzgraph/setup}{#1}}
%<--------------------------------------------------------------------------->
%                    Recording of the graph (vertices, edges)
%<--------------------------------------------------------------------------->
% Each tikzpicture starts a new record. \tkzgr@vlist : names of the
% vertices in order of creation ; \tkzgr@elist : edges A/B (a loop is A/A).
% Used by \tkzAdjacencyMatrix.
% Hooks (empty here) used by the option lua (tkz-graph-lua.tex) :
%   \tkzgr@hook@reset            a new tikzpicture starts
%   \tkzgr@hook@vertex{name}     a vertex is created (or drawn again)
%   \tkzgr@hook@edge{A}{B}{label}{arrow}  an edge (A=B : a loop) ; label
%                                and arrow are macros or values
\let\tkzgr@hook@reset\relax
\let\tkzgr@hook@vertex\@gobble
\def\tkzgr@hook@edge#1#2#3#4{}
\def\tkzgr@resetrecord{\global\let\tkzgr@vlist\@empty
                       \global\let\tkzgr@elist\@empty
                       \tkzgr@hook@reset}
\tkzgr@resetrecord
\def\tkzgr@recordvertex#1{%
  \protected@edef\tkzgr@vn{#1}%
  \edef\tkzgr@tmp{\noexpand\in@{,\tkzgr@vn,}{,\tkzgr@vlist,}}%
  \tkzgr@tmp
  \ifin@\else
    \xdef\tkzgr@vlist{\ifx\tkzgr@vlist\@empty\else\tkzgr@vlist,\fi
                      \tkzgr@vn}%
  \fi
  \tkzgr@hook@vertex{#1}}
\def\tkzgr@recordedge#1#2{%
  \protected@edef\tkzgr@vn{#1/#2}%
  \xdef\tkzgr@elist{\ifx\tkzgr@elist\@empty\else\tkzgr@elist,\fi
                    \tkzgr@vn}}
%<--------------------------------------------------------------------------->
%                         \tkzHighlightPath
%<--------------------------------------------------------------------------->
% \tkzHighlightPath[options]{A,B,C,D}  path A-B-C-D drawn again over the
%                                      edges (cycle : D-A added)
% \tkzHighlightPath[options]{A/B,C/D}  edges A-B and C-D
% options : color (red), lw (1.6pt), style (tikz options, for example
% bend left=20 to follow a bent edge), cycle
\tkzgr@cmdkey{hl}{color}
\tkzgr@cmdkey{hl}{lw}
\tkzgr@cmdkey{hl}{style}
\tkzgr@boolkey{hl}{cycle}
\tkzgr@presetkeys{hl}{color = red,
                      lw    = 1.6pt,
                      style = {},
                      cycle = false}
\newcommand*{\tkzHighlightPath}[2][]{%
\begingroup
  \tkzgr@setkeys{hl}{#1}%
  \in@{/}{#2}%
  \ifin@
    \foreach \tkzgr@ha/\tkzgr@hb in {#2}{\tkzgr@hledge{\tkzgr@ha}{\tkzgr@hb}}%
  \else
    \setcounter{tkz@gr@p}{0}%
    \foreach \tkzgr@fin in {#2}{%
      \ifnum\value{tkz@gr@p}=0
        \global\let\tkzgr@first\tkzgr@fin
        \stepcounter{tkz@gr@p}%
      \else
        \tkzgr@hledge{\tkzgr@deb}{\tkzgr@fin}%
      \fi
      \global\let\tkzgr@deb\tkzgr@fin}%
    \ifGR@hl@cycle\tkzgr@hledge{\tkzgr@deb}{\tkzgr@first}\fi
  \fi
\endgroup}
\def\tkzgr@hledge#1#2{%
  \protected@edef\@tempa{\noexpand\draw[color = \cmdGR@hl@color,
                                        line width = \cmdGR@hl@lw,
                                        \cmdGR@hl@style] (#1) to (#2)}%
  \@tempa;}
%<--------------------------------------------------------------------------->
%                        Adjacency matrix
%<--------------------------------------------------------------------------->
% \tkzAdjacencyMatrix[options] : matrix of the graph of the last
% tikzpicture (math mode or not). Entry (i,j) : number of edges between
% the i-th and the j-th vertex (a loop counts 1).
% options : directed (edge A-B counts only for (A,B)),
%           order = {A,B,...} (default : order of creation)
\newcount\tkzgr@cnt
\tkzgr@boolkey{adj}{directed}
\tkzgr@cmdkey{adj}{order}
\tkzgr@presetkeys{adj}{directed = false,
                       order    = {}}
% \tkzgr@countedges{i}{j} -> \tkzgr@cnt
\def\tkzgr@countedges#1#2{%
  \tkzgr@cnt\z@
  \edef\tkzgr@i{#1}\edef\tkzgr@j{#2}%
  \@for\tkzgr@e:=\tkzgr@elist\do{%
    \ifx\tkzgr@e\@empty\else
      \expandafter\tkzgr@cmpedge\tkzgr@e\@nil
    \fi}}
\def\tkzgr@cmpedge#1/#2\@nil{%
  \def\tkzgr@u{#1}\def\tkzgr@v{#2}%
  \ifx\tkzgr@u\tkzgr@i
    \ifx\tkzgr@v\tkzgr@j\advance\tkzgr@cnt\@ne\fi
  \else
    \ifGR@adj@directed\else
      \ifx\tkzgr@u\tkzgr@j
        \ifx\tkzgr@v\tkzgr@i\advance\tkzgr@cnt\@ne\fi
      \fi
    \fi
  \fi}
\newcommand*{\tkzAdjacencyMatrix}[1][]{%
\begingroup
  \tkzgr@setkeys{adj}{#1}%
  \tkzgr@ifempty{\cmdGR@adj@order}%
    {\let\tkzgr@order\tkzgr@vlist}%
    {\edef\tkzgr@order{\cmdGR@adj@order}}%
  \global\let\tkzgr@rows\@empty
  \global\let\tkzgr@cols\@empty
  \foreach \tkzgr@a in \tkzgr@order {%
    \xdef\tkzgr@cols{\tkzgr@cols c}%
    \global\let\tkzgr@row\@empty
    \foreach \tkzgr@b in \tkzgr@order {%
      \tkzgr@countedges{\tkzgr@a}{\tkzgr@b}%
      \xdef\tkzgr@row{\ifx\tkzgr@row\@empty\else\tkzgr@row&\fi
                      \the\tkzgr@cnt}}%
    \xdef\tkzgr@rows{\ifx\tkzgr@rows\@empty\else
                       \unexpanded\expandafter{\tkzgr@rows}\noexpand\\\fi
                     \tkzgr@row}}%
  \edef\tkzgr@tmp{\noexpand\left(\noexpand\begin{array}{\tkzgr@cols}%
     \unexpanded\expandafter{\tkzgr@rows}\noexpand\end{array}\noexpand\right)}%
  \ensuremath{\tkzgr@tmp}%
\endgroup}
%<--------------------------------------------------------------------------->
%                       Graph from a matrix
%<--------------------------------------------------------------------------->
% \tkzGraphFromMatrix[options]{A,B,C}{0,1,1;1,0,1;1,1,0}
% rows separated by ; entries by , (decimal point : .)
% A non-zero entry (i,j) gives an edge (i,j) ; on the diagonal a loop.
% options :
%  placed        the vertices already exist (otherwise they are drawn
%                on a circle, as \Vertices{circle})
%  unit, rotation, clockwise   for the circle
%  directed      arrows ; edges i->j and j->i are bent
%  weighted      the entries are written on the edges
%  style         tikz options added to each edge
%  loop distance size of the loops (1cm)
%  bend          angle used for the pairs i->j, j->i (15)
\tkzgr@boolkey{mat}{placed}
\tkzgr@boolkey{mat}{directed}
\tkzgr@boolkey{mat}{weighted}
\tkzgr@boolkey{mat}{clockwise}
\tkzgr@cmdkey{mat}{unit}
\tkzgr@cmdkey{mat}{rotation}
\tkzgr@cmdkey{mat}{style}
\tkzgr@cmdkey{mat}{loopdist}
\pgfkeys{/tkzgraph/mat/loop distance/.style = {/tkzgraph/mat/loopdist = #1}}
\tkzgr@cmdkey{mat}{bend}
\tkzgr@presetkeys{mat}{placed        = false,
                       directed      = false,
                       weighted      = false,
                       clockwise     = false,
                       unit          = \GraphUnit,
                       rotation      = 0,
                       style         = {},
                       loopdist      = 1cm,
                       bend          = 15}
\newcount\tkzgr@mi
\newcount\tkzgr@mj
\newcount\tkzgr@mn
\newcommand*{\tkzGraphFromMatrix}[3][]{%
\begingroup
  \tkzgr@setkeys{mat}{#1}%
  % names : \tkzgr@m@name@<i>
  \tkzgr@mn\z@
  \@for\tkzgr@a:=#2\do{%
    \advance\tkzgr@mn\@ne
    \expandafter\let\csname tkzgr@m@name@\the\tkzgr@mn\endcsname\tkzgr@a}%
  % entries : \tkzgr@m@<i>@<j>
  \tkzgr@mi\z@
  \tkzgr@rowsloop#3;\relax;%
  % vertices
  \ifGR@mat@placed\else
    \edef\tkzgr@tmp{\noexpand\tkzgr@Vertices[unit = \cmdGR@mat@unit,
                    rotation = \cmdGR@mat@rotation,
                    clockwise = \ifGR@mat@clockwise true\else false\fi]%
                    {circle}{#2}}%
    \tkzgr@tmp
  \fi
  \tkzgr@centroid
  % edges and loops
  \tkzgr@mi\z@
  \loop\ifnum\tkzgr@mi<\tkzgr@mn
    \advance\tkzgr@mi\@ne
    {\tkzgr@mj\z@
     \loop\ifnum\tkzgr@mj<\tkzgr@mn
       \advance\tkzgr@mj\@ne
       \tkzgr@matentry
     \repeat}%
  \repeat
\endgroup}
% one row : #1 = 0,1,1
\def\tkzgr@rowsloop#1;{%
  \ifx\relax#1\else
    \advance\tkzgr@mi\@ne
    \tkzgr@mj\z@
    \@for\tkzgr@a:=#1\do{%
      \advance\tkzgr@mj\@ne
      \expandafter\let
        \csname tkzgr@m@\the\tkzgr@mi @\the\tkzgr@mj\endcsname\tkzgr@a}%
    \expandafter\tkzgr@rowsloop
  \fi}
% \tkzgr@ifnonzero{value}{true}{false}
\def\tkzgr@ifnonzero#1{%
  \tkzgr@ifempty{#1}{\@secondoftwo}{%
    \pgfmathparse{(#1)!=0}%
    \ifdim\pgfmathresult pt>\z@
      \expandafter\@firstoftwo
    \else
      \expandafter\@secondoftwo
    \fi}}
\def\tkzgr@mval#1#2{\csname tkzgr@m@#1@#2\endcsname}
\def\tkzgr@mname#1{\csname tkzgr@m@name@#1\endcsname}
% centre of the vertices -> \tkzgr@cx, \tkzgr@cy (pt)
\def\tkzgr@centroid{%
  \def\tkzgr@cx{0}\def\tkzgr@cy{0}%
  \tkzgr@mi\z@
  \loop\ifnum\tkzgr@mi<\tkzgr@mn
    \advance\tkzgr@mi\@ne
    \pgfextractx{\pgf@xa}{\pgfpointanchor{\tkzgr@mname{\the\tkzgr@mi}}{center}}%
    \pgfextracty{\pgf@ya}{\pgfpointanchor{\tkzgr@mname{\the\tkzgr@mi}}{center}}%
    \pgfmathsetmacro\tkzgr@cx{\tkzgr@cx+\pgf@xa/\the\tkzgr@mn}%
    \pgfmathsetmacro\tkzgr@cy{\tkzgr@cy+\pgf@ya/\the\tkzgr@mn}%
  \repeat}
% entry (\tkzgr@mi,\tkzgr@mj)
\def\tkzgr@matentry{%
  \edef\tkzgr@v{\tkzgr@mval{\the\tkzgr@mi}{\the\tkzgr@mj}}%
  \tkzgr@ifnonzero{\tkzgr@v}{%
    \ifnum\tkzgr@mi=\tkzgr@mj
      \tkzgr@matloop
    \else
      \ifGR@mat@directed
        \tkzgr@matedge
      \else
        \ifnum\tkzgr@mi<\tkzgr@mj\tkzgr@matedge\fi
      \fi
    \fi}{}}
\def\tkzgr@matedge{%
  \def\tkzgr@bend{}%
  \ifGR@mat@directed
    \edef\tkzgr@w{\tkzgr@mval{\the\tkzgr@mj}{\the\tkzgr@mi}}%
    \tkzgr@ifnonzero{\tkzgr@w}{\edef\tkzgr@bend{bend left=\cmdGR@mat@bend}}{}%
  \fi
  \edef\tkzgr@tmp{\noexpand\tkzgr@Edge[%
      \ifGR@mat@directed ->,\fi
      \ifGR@mat@weighted label = {$\tkzgr@v$},\fi
      style = {\tkzgr@bend,\unexpanded\expandafter{\cmdGR@mat@style}}]%
      (\tkzgr@mname{\the\tkzgr@mi})(\tkzgr@mname{\the\tkzgr@mj})}%
  \tkzgr@tmp}
% loop directed away from the centre
\def\tkzgr@matloop{%
  \edef\tkzgr@n{\tkzgr@mname{\the\tkzgr@mi}}%
  \pgfextractx{\pgf@xa}{\pgfpointanchor{\tkzgr@n}{center}}%
  \pgfextracty{\pgf@ya}{\pgfpointanchor{\tkzgr@n}{center}}%
  \pgfmathsetmacro\tkzgr@dx{\pgf@xa-\tkzgr@cx}%
  \pgfmathsetmacro\tkzgr@dy{\pgf@ya-\tkzgr@cy}%
  \pgfmathsetmacro\tkzgr@th{%
     (abs(\tkzgr@dx)+abs(\tkzgr@dy)<0.01) ? 90 : atan2(\tkzgr@dy,\tkzgr@dx)}%
  \tkzgr@recordedge{\tkzgr@n}{\tkzgr@n}%
  \tkzgr@hook@edge{\tkzgr@n}{\tkzgr@n}{\tkzgr@v}{}%
  \protected@edef\@tempa{\noexpand\draw[EdgeStyle,
      color = \EdgeColor, line width = \EdgeLineWidth,
      \ifGR@mat@directed ->, >={\tkzgr@arrowtip},\fi
      \cmdGR@mat@style]
    (\tkzgr@n) to[out = \tkzgr@th+35, in = \tkzgr@th-35,
                  distance = \cmdGR@mat@loopdist]
    \ifGR@mat@weighted
      node[fill = \LabelFillColor, text = \LabelTextColor, LabelStyle]
          {$\tkzgr@v$}%
    \fi
    (\tkzgr@n)}%
  \@tempa;}
% probabilistic graph : weighted and directed graph from the matrix
% of transition
\newcommand*{\grProbMatrix}[3][]{%
  \tkzGraphFromMatrix[directed,weighted,#1]{#2}{#3}}
%<--------------------------------------------------------------------------->
%                       Short names and prefixed names
%<--------------------------------------------------------------------------->
% The code uses only \tkzgr@<name>. The prefixed names \tkz<name> are
% always defined. The short names \<name> are installed
%  - at the loading of the package, only if they are not defined
%    (otherwise a warning) ;
%  - at the beginning of each tikzpicture (local definitions, so a
%    user definition of \EA, \NO ... is restored after the picture).
% With the option noshortnames, the short names are never defined.
\def\tkzgr@shortlist{Vertex,Vertices,Edge,Edges,Loop,%
                     EA,WE,NO,SO,NOEA,NOWE,SOEA,SOWE}
\@for\tkzgr@n:=\tkzgr@shortlist\do{%
  \expandafter\let\csname tkz\tkzgr@n\expandafter\endcsname
                  \csname tkzgr@\tkzgr@n\endcsname}
\def\tkzgr@shortnames{%
  \let\Vertex\tkzgr@Vertex
  \let\Vertices\tkzgr@Vertices
  \let\Edge\tkzgr@Edge
  \let\Edges\tkzgr@Edges
  \let\Loop\tkzgr@Loop
  \let\EA\tkzgr@EA
  \let\WE\tkzgr@WE
  \let\NO\tkzgr@NO
  \let\SO\tkzgr@SO
  \let\NOEA\tkzgr@NOEA
  \let\NOWE\tkzgr@NOWE
  \let\SOEA\tkzgr@SOEA
  \let\SOWE\tkzgr@SOWE}
\iftkzgr@short
  \@for\tkzgr@n:=\tkzgr@shortlist\do{%
    \@ifundefined{\tkzgr@n}{%
      \expandafter\let\csname\tkzgr@n\expandafter\endcsname
                      \csname tkzgr@\tkzgr@n\endcsname}{%
      \PackageWarningNoLine{tkz-graph}{\expandafter\string
        \csname\tkzgr@n\endcsname\space is already defined. Inside the
        tikzpicture environments it is replaced by the command of
        tkz-graph ; outside, use \expandafter\string
        \csname tkz\tkzgr@n\endcsname}}}
  \ifdefined\AddToHook
    \AddToHook{env/tikzpicture/begin}{\tkzgr@shortnames}
  \else
    \tikzset{every picture/.append style={%
      execute at begin picture=\tkzgr@shortnames}}
  \fi
\fi
% new record of the graph at the beginning of each picture
\ifdefined\AddToHook
  \AddToHook{env/tikzpicture/begin}{\tkzgr@resetrecord}
\else
  \tikzset{every picture/.append style={%
    execute at begin picture=\tkzgr@resetrecord}}
\fi
% options lua and 3d : the files tkz-graph-lua.tex and tkz-graph-3d.tex
% (parts of tkz-graph, not packages) are read once, at the end of the
% package ; tkz-berge calls the same macros for its options.
\def\tkzgr@inputpart#1{%
  \edef\tkzgr@atcode{\the\catcode`\@}%
  \catcode`\@=11
  \IfFileExists{#1}{\input{#1}}{%
    \PackageError{tkz-graph}{File #1 not found}{It is a part of tkz-graph:
      install it next to tkz-graph.sty.}}%
  \catcode`\@=\tkzgr@atcode\relax}
\def\tkzgr@noluatex{%
  \PackageError{tkz-graph}{The options lua and 3d need LuaLaTeX}{%
    Compile with lualatex, or remove the option: tkz-graph alone works
    with pdfLaTeX. The option is ignored.}%
  \global\let\tkzgr@loadlua\relax
  \global\let\tkzgr@loadthreed\relax}
\def\tkzgr@loadlua{%
  \ifdefined\directlua
    \global\let\tkzgr@loadlua\relax
    \tkzgr@inputpart{tkz-graph-lua.tex}%
  \else
    \tkzgr@noluatex
  \fi}
\def\tkzgr@loadthreed{%
  \tkzgr@loadlua
  \ifdefined\directlua
    \global\let\tkzgr@loadthreed\relax
    \tkzgr@inputpart{tkz-graph-3d.tex}%
  \fi}
\AtEndOfPackage{%
  \iftkzgr@threed\tkzgr@loadthreed\else\iftkzgr@lua\tkzgr@loadlua\fi\fi}
\endinput
