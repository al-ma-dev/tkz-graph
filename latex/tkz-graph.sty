%<--------------------------------------------------------------------------->
%            Keys : a small layer on pgfkeys (replaces xkeyval)
%<--------------------------------------------------------------------------->
% All the keys live in /tkzgraph/<family>/<key>. The macros below
% reproduce the xkeyval commands used before 2.1 :
%  \tkzgr@cmdkey{fam}{key}          \define@cmdkey[GR]{fam}{key}{}
%  \tkzgr@cmdkeydef{fam}{key}{def}  \define@cmdkey[GR]{fam}{key}[def]{}
%  \tkzgr@boolkey{fam}{key}         \define@boolkey[GR]{fam}{key}[true]{}
%  \tkzgr@choicekey{fam}{key}{list}{code}
%                                   \define@choicekey*[GR]{fam}{key}[\val\nr]
%                                                     {list}{code}
%  \tkzgr@presetkeys{fam}{k=v,...}  \presetkeys[GR]{fam}{k=v,...}{}
%  \tkzgr@setkeys{fam}{k=v,...}     \setkeys[GR]{fam}{k=v,...}
% A key "key" of the family "fam" stores its value in \cmdGR@fam@key
% (or sets the boolean \ifGR@fam@key), as xkeyval did.
%<--------------------------------------------------------------------------->
\def\tkzgr@cmdkey#1#2{%
  \expandafter\tkzgr@cmdkey@\csname cmdGR@#1@#2\endcsname{#1}{#2}}
\def\tkzgr@cmdkey@#1#2#3{\pgfkeys{/tkzgraph/#2/#3/.store in=#1}}
\def\tkzgr@cmdkeydef#1#2#3{%
  \tkzgr@cmdkey{#1}{#2}%
  \pgfkeys{/tkzgraph/#1/#2/.default={#3}}}
\def\tkzgr@boolkey#1#2{%
  \expandafter\newif\csname ifGR@#1@#2\endcsname
  \pgfkeys{/tkzgraph/#1/#2/.is if  = GR@#1@#2,
           /tkzgraph/#1/#2/.default = true}}
%<--------------------------------------------------------------------------->
% choice keys : the value is compared without case ; \val is the value
% found in the list, \nr its rank (0,1,...) ; then <code> is executed
\def\tkzgr@choicekey#1#2#3#4{%
  \expandafter\def\csname tkzgr@cl@#1@#2\endcsname{#3}%
  \expandafter\def\csname tkzgr@cc@#1@#2\endcsname{#4}%
  \pgfkeys{/tkzgraph/#1/#2/.code={\tkzgr@dochoice{#1}{#2}{##1}}}}
\def\tkzgr@dochoice#1#2#3{%
  \edef\tkzgr@cv{#3}%
  \tkzgr@lowercase\tkzgr@cv
  \def\nr{-1}%
  \@tempcnta\z@
  \expandafter\expandafter\expandafter\@for
  \expandafter\expandafter\expandafter\tkzgr@c
  \expandafter\expandafter\expandafter:%
  \expandafter\expandafter\expandafter=%
  \csname tkzgr@cl@#1@#2\endcsname\do{%
    \let\tkzgr@lc\tkzgr@c
    \tkzgr@lowercase\tkzgr@lc
    \ifx\tkzgr@lc\tkzgr@cv
      \edef\nr{\the\@tempcnta}%
      \let\val\tkzgr@c
    \fi
    \advance\@tempcnta\@ne}%
  \ifnum\nr<\z@
    \PackageError{tkz-graph}{Value `#3' is not allowed for the key `#2'}%
      {Allowed values: \csname tkzgr@cl@#1@#2\endcsname}%
  \else
    \csname tkzgr@cc@#1@#2\endcsname
  \fi}
\def\tkzgr@lowercase#1{%
  \lowercase\expandafter{\expandafter\def\expandafter#1\expandafter{#1}}}
%<--------------------------------------------------------------------------->
% preset values : list of the names in \tkzgr@pl@<fam> (order of the
% first preset) and value of each key in \tkzgr@pv@<fam>@<key>.
% As with \presetkeys : a new value replaces the old one, local
% definitions (a group limits the change).
\def\tkzgr@novalue{\pgfkeysnovalue}
\pgfkeys{/tkzgraph/@preset/.unknown/.code = {\tkzgr@addpreset{#1}}}
\def\tkzgr@presetkeys#1#2{%
  \def\tkzgr@pfam{#1}%
  \pgfqkeys{/tkzgraph/@preset}{#2}}
\def\tkzgr@addpreset#1{%
  \edef\tkzgr@k{\pgfkeyscurrentname}%
  \expandafter\ifx\csname tkzgr@pl@\tkzgr@pfam\endcsname\relax
    \expandafter\let\csname tkzgr@pl@\tkzgr@pfam\endcsname\@empty
  \fi
  \edef\tkzgr@tmp{\noexpand\in@{,\tkzgr@k,}%
                  {,\csname tkzgr@pl@\tkzgr@pfam\endcsname,}}%
  \tkzgr@tmp
  \ifin@\else
    \expandafter\edef\csname tkzgr@pl@\tkzgr@pfam\endcsname{%
      \csname tkzgr@pl@\tkzgr@pfam\endcsname,\tkzgr@k}%
  \fi
  \expandafter\def\csname tkzgr@pv@\tkzgr@pfam @\tkzgr@k\endcsname{#1}}
%<--------------------------------------------------------------------------->
% \tkzgr@setkeys{fam}{list} : 1) the preset values of the keys absent
% from list, 2) list.
\pgfkeys{/tkzgraph/@mark/.unknown/.code = {%
  \edef\tkzgr@given{\tkzgr@given\pgfkeyscurrentname,}}}
\def\tkzgr@setkeys#1#2{%
  \def\tkzgr@given{,}%
  \pgfqkeys{/tkzgraph/@mark}{#2}%
  \let\tkzgr@todo\@empty
  \expandafter\let\expandafter\tkzgr@list\csname tkzgr@pl@#1\endcsname
  \ifx\tkzgr@list\relax\let\tkzgr@list\@empty\fi
  \@for\tkzgr@k:=\tkzgr@list\do{%
    \ifx\tkzgr@k\@empty\else
      \edef\tkzgr@tmp{\noexpand\in@{,\tkzgr@k,}{\tkzgr@given}}%
      \tkzgr@tmp
      \ifin@\else
        \expandafter\let\expandafter\tkzgr@v
          \csname tkzgr@pv@#1@\tkzgr@k\endcsname
        \ifx\tkzgr@v\tkzgr@novalue
          \edef\tkzgr@todo{\unexpanded\expandafter{\tkzgr@todo}\tkzgr@k,}%
        \else
          \edef\tkzgr@todo{\unexpanded\expandafter{\tkzgr@todo}%
            \tkzgr@k={\unexpanded\expandafter{\tkzgr@v}},}%
        \fi
      \fi
    \fi}%
  \edef\tkzgr@tmp{\noexpand\pgfqkeys{/tkzgraph/#1}%
                  {\unexpanded\expandafter{\tkzgr@todo}}}%
  \tkzgr@tmp
  \pgfqkeys{/tkzgraph/#1}{#2}}
% \tkzgr@ifempty{<text>}{<if empty>}{<if not empty>}
% (replaces \ifthenelse{\equal{<text>}{}}, same expansion)
\def\tkzgr@ifempty#1{%
  \protected@edef\tkzgr@tmpe{#1}%
  \ifx\tkzgr@tmpe\@empty
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi}
