\newcommand*{\tkzgr@Edge}[1][]{\tkzgr@edge[#1]}%
\def\tkzgr@edge[#1](#2)(#3){%
\tkzgr@setkeys{edge}{#1}%
% \Edge(A)(A) draws nothing (tkz-berge uses it) : it is not recorded,
% and without label and arrow it is not drawn (no pgf warning)
\protected@edef\tkzgr@edA{#2}\protected@edef\tkzgr@edB{#3}%
\let\tkzgr@next\@firstofone
\ifx\tkzgr@edA\tkzgr@edB
  \tkzgr@ifempty{\cmdGR@edge@label\cmdGR@edge@arrow}%
    {\let\tkzgr@next\@gobble}{}%
\else
  \tkzgr@recordedge{#2}{#3}%
  \tkzgr@hook@edge{#2}{#3}{\cmdGR@edge@label}{\cmdGR@edge@arrow}%
\fi
\tkzgr@next{%
 \begingroup%
\tkzgr@ifempty{\cmdGR@edge@arrow}%
  {\let\tkzgr@arrowopts\@empty}%
  {\edef\tkzgr@arrowopts{,\cmdGR@edge@arrow,>={\tkzgr@arrowtip}}}%
\tkzgr@ifempty{\cmdGR@edge@double}{%
\tikzset{LocalEdgeStyle/.style={color = \cmdGR@edge@color,
                                line width = \cmdGR@edge@lw}}}{%
\tikzset{LocalEdgeStyle/.style={line width = \cmdGR@edge@dd,
                                color = \cmdGR@edge@double,
                                double distance = \cmdGR@edge@lw,
                                double  = \cmdGR@edge@color}}}%
\ifGR@edge@local%
      \tikzset{EdgeStyle/.style={}}%
      \fi
   \tkzgr@ifempty{\cmdGR@edge@label}{%
     \protected@edef\@tempa{%
     \noexpand   \draw[LocalEdgeStyle,\cmdGR@edge@style,EdgeStyle\tkzgr@arrowopts]}%
                 \@tempa (#2) to (#3)}{%
     \protected@edef\@tempa{%
     \noexpand   \draw[LocalEdgeStyle,\cmdGR@edge@style,EdgeStyle\tkzgr@arrowopts] (#2) to%
    node[fill = \cmdGR@edge@labelcolor,
         text = \cmdGR@edge@labeltext,
         \cmdGR@edge@labelstyle,LabelStyle]}\@tempa
   {\cmdGR@edge@label} (#3)}%
   ;
\endgroup}%
}%
