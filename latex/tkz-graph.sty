%<--------------------------------------------------------------------------->
%                    Graph styles (key vstyle of \GraphInit)
%<--------------------------------------------------------------------------->
% Each style is the key /tkzgraph/vstyle/<name> (name in lower case).
% \tkzDefGraphStyle{<name>}{<code>} defines (or redefines) a style ;
% \GraphInit[vstyle=<name>] executes <code> ; the name is case
% insensitive. Example :
%  \tkzDefGraphStyle{Red}{\GraphInit[vstyle=Normal]\SetGraphColor{red!20}{red}}
\newcommand{\tkzDefGraphStyle}[2]{%
  \edef\tkzgr@cv{#1}%
  \tkzgr@lowercase\tkzgr@cv
  \pgfkeys{/tkzgraph/vstyle/\tkzgr@cv/.code={#2}}}
\def\tkzgr@vstyle#1{%
  \edef\tkzgr@cv{#1}%
  \tkzgr@lowercase\tkzgr@cv
  \pgfkeysifdefined{/tkzgraph/vstyle/\tkzgr@cv/.@cmd}%
    {\pgfkeys{/tkzgraph/vstyle/\tkzgr@cv}}%
    {\PackageError{tkz-graph}{Value `#1' is not allowed for the key
       `vstyle'}{The styles are Empty, Hasse, Simple, Classic,
       Normal, Shade, Dijkstra, Welsh, Art, Shade Art and the styles
       defined with \string\tkzDefGraphStyle.}}}
% the styles Empty, Hasse, Simple, Classic, Dijkstra and Welsh differ
% only by these values :
% #1 preset of the key vertex (label), #2 draw or nothing,
% #3 fill, #4 outer sep, #5 minimum size
\def\tkzgr@basicvstyle#1#2#3#4#5{%
\tkzgr@presetkeys{vertex}{#1}%
\tikzset{VertexStyle/.style = {#2shape     = \VertexShape,
                               color          = \VertexLineColor,
                               fill           = #3,
                               inner sep      = \VertexInnerSep,
                               outer sep      = #4,
                               text           = \VertexTextColor,
                               minimum size   = #5,
                               line width     = \VertexLineWidth}}
\tikzset{EdgeStyle/.style   = {line width     = \EdgeLineWidth,
                                                \EdgeColor}}
\tikzset{LabelStyle/.style={}}}
\tkzDefGraphStyle{Empty}{%
  \tkzgr@basicvstyle{LabelOut = false}{}{\VertexLightFillColor}%
                    {0.5\pgflinewidth}{\VertexSmallMinSize}}
\tkzDefGraphStyle{Hasse}{%
  \tkzgr@basicvstyle{NoLabel = true}{draw,}{\VertexLightFillColor}%
                    {0.5\pgflinewidth}{\VertexSmallMinSize}}
\tkzDefGraphStyle{Simple}{%
  \tkzgr@basicvstyle{NoLabel = true}{draw,}{\VertexDarkFillColor}%
                    {0.5\pgflinewidth}{\VertexSmallMinSize}}
\tkzDefGraphStyle{Classic}{%
  \tkzgr@basicvstyle{LabelOut = true}{draw,}{\VertexDarkFillColor}%
                    {0.5\pgflinewidth}{\VertexSmallMinSize}}
\tkzDefGraphStyle{Dijkstra}{%
  \tkzgr@basicvstyle{LabelOut = false}{draw,}{\VertexLightFillColor}%
                    {0.5\pgflinewidth}{\VertexInterMinSize}}
\tkzDefGraphStyle{Welsh}{%
  \tkzgr@basicvstyle{LabelOut = true}{draw,}{\VertexLightFillColor}%
                    {\VertexOuterSep}{\VertexSmallMinSize}}
\tkzDefGraphStyle{Normal}{%
\tkzgr@presetkeys{vertex}{LabelOut            = false}%
\tikzset{VertexStyle/.style = {draw,
                               shape           = \VertexShape,
                               minimum size    = \VertexInterMinSize,
                               line width      = \VertexLineWidth,
                               color           = \VertexLineColor,
                               outer sep       = 0.5\pgflinewidth,
                               fill            = \VertexLightFillColor,
                               text            = \VertexTextColor,
                               line width      = \VertexLineWidth}}
\tikzset{EdgeStyle/.style   = {line width      = \EdgeLineWidth,
                                                 \EdgeColor}}
\tikzset{LabelStyle/.style={}}}
\tkzDefGraphStyle{Shade}{%
\tkzgr@presetkeys{vertex}{LabelOut            = false}%
\tikzset{VertexStyle/.style = {draw,
                               shape           = \VertexShape,
                               ball color      = \VertexBallColor,
                               color           = \VertexLineColor,
                               text            = \VertexTextColor,
                               inner sep       = \VertexInnerSep,
                               outer sep       = \VertexOuterSep,
                               minimum size    = \VertexBigMinSize,
                               line width      = \VertexLineWidth}}
\tikzset{EdgeStyle/.style   = {line width      = \EdgeLineWidth,
                                                 \EdgeColor,% color outside
                               double          = \EdgeFillColor,% inside
                               double distance = \EdgeDoubleDistance}}%
\tikzset{LabelStyle/.style={}}}
\tkzDefGraphStyle{Art}{%
\tkzgr@presetkeys{vertex}{NoLabel            = true}%
\tikzset{VertexStyle/.style = {shape          = \VertexShape,
                               ball color     = \VertexBallColor,
                               color          = \VertexLineColor,
                               inner sep      = \VertexInnerSep,
                               outer sep      = \VertexOuterSep,
                               minimum size   = \VertexSmallMinSize,
                               line width     = \VertexLineWidth}}%
\tikzset{EdgeStyle/.style   = {line width      = \EdgeLineWidth,
                                                 \EdgeArtColor}}
\tikzset{LabelStyle/.style  = {}}}
\tkzDefGraphStyle{Shade Art}{%
\tkzgr@presetkeys{vertex}{NoLabel            = true}%
\tikzset{VertexStyle/.style = {shape          = \VertexShape,
                               ball color     = \VertexBallColor,
                               inner sep      = \VertexInnerSep,
                               outer sep      = \VertexOuterSep,
                               minimum size   = \VertexSmallMinSize,
                               line width     = \VertexLineWidth}}
\tikzset{EdgeStyle/.style   = {line width      = \EdgeLineWidth,
                                                 \EdgeColor,
                               double          = \EdgeFillColor,
                               double distance = .5\EdgeDoubleDistance}}
\tikzset{LabelStyle/.style  = {}}}
