%    Relative position : \EA (east) \WE (west) \NO (north) \SO (south)
%                        \NOEA \NOWE \SOEA \SOWE
% \tkzgr@relative{<name>}{<x factor>}{<y factor>}
%<--------------------------------------------------------------------------->
\def\tkzgr@relative#1#2#3{%
  \expandafter\newcommand\expandafter*\csname tkzgr@#1\endcsname[1][]{%
    \csname tkzgr@@#1\endcsname[##1]}%
  \expandafter\def\csname tkzgr@@#1\endcsname[##1](##2)##3{%
    \begingroup
      \tkzgr@setkeys{vertex}{##1}%
      \path (##2)--++(#2\cmdGR@vertex@unit,#3\cmdGR@vertex@unit)
            coordinate (##3);
      \tkzgr@Vertex[##1,Node]{##3}
    \endgroup}}
\tkzgr@relative{EA}{}{0*}
\tkzgr@relative{WE}{-}{0*}
\tkzgr@relative{NO}{0*}{}
\tkzgr@relative{SO}{0*}{-}
\tkzgr@relative{NOEA}{}{}
\tkzgr@relative{NOWE}{-}{}
\tkzgr@relative{SOEA}{}{-}
\tkzgr@relative{SOWE}{-}{-}
