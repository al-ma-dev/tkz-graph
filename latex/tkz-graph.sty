\newcommand*{\tkzgr@Vertex}[1][]{\tkzgr@vertex[#1]}%
\def\tkzgr@vertex[#1]#2{%
    \tkzgr@setkeys{vertex}{#1}%
    \tkzgr@@vertex{#2}%
}
% #1 name of the vertex
\def\tkzgr@@vertex#1{%
\tkzgr@recordvertex{#1}%
\def\tkzgr@nstyle{VertexStyle}%
%<--------------------------------------------------------------------------->
\ifGR@vertex@Node%
   \pgfextractx{\pgf@x}{\pgfpointanchor{#1}{center}}
   \pgfextracty{\pgf@y}{\pgfpointanchor{#1}{center}}
   \edef\cmdGR@vertex@x{\pgf@x}
   \edef\cmdGR@vertex@y{\pgf@y}
\fi%
%<--------------------------------------------------------------------------->
\ifGR@vertex@empty%
   \begin{scope}
      \tkzgr@ifempty{\cmdGR@vertex@x}{%
       \tkzgr@ifempty{\cmdGR@vertex@d}{%
           \protected@edef\@tempa{%
               \noexpand \node[inner sep = 0pt](#1)%
                  [\cmdGR@vertex@position]{}}%
           \@tempa;}{%
           \protected@edef\@tempa{%
               \noexpand\node[inner sep = 0pt](#1)%
                  at (\cmdGR@vertex@a:\cmdGR@vertex@d){}}%
           \@tempa;}}{%
           \protected@edef\@tempa{%
               \noexpand\node[inner sep = 0pt](#1)%
                  at (\cmdGR@vertex@x,\cmdGR@vertex@y){}}%
           \@tempa;}%
    \end{scope}
\else
 \begin{scope}[label distance = \cmdGR@vertex@Ldist]
  \ifGR@vertex@NoLabel
       \def\tkzgr@vertex@Label{}%
       \def\cmdGR@vertex@L{}%
       \def\tkzgr@vertex@Name{}%
  \else%
     \ifGR@vertex@Math
       \tkzgr@ifempty{\cmdGR@vertex@L}%
         {\def\tkzgr@vertex@Name{$#1$}}%
         {\def\tkzgr@vertex@Name{$\cmdGR@vertex@L$}}%
     \else
       \tkzgr@ifempty{\cmdGR@vertex@L}%
         {\def\tkzgr@vertex@Name{#1}}%
         {\def\tkzgr@vertex@Name{\cmdGR@vertex@L}}%
     \fi%
      \ifGR@vertex@LabelOut%
        \def\tkzgr@nstyle{VertexStyle,%
                    label={[text = \cmdGR@SVN@TextColor,\cmdGR@vertex@style]%
                    \cmdGR@vertex@Lpos:\tkzgr@vertex@Name}}%
        \def\tkzgr@vertex@Label{}%
      \else%
      \def\tkzgr@vertex@Label{\tkzgr@vertex@Name}%
      \fi
  \fi
%<--------------------------------------------------------------------------->
  \tkzgr@ifempty{\cmdGR@vertex@x}{%
      \tkzgr@ifempty{\cmdGR@vertex@d}{%
        \protected@edef\@tempa{%
        \noexpand\node[outer sep=0pt,\cmdGR@vertex@style,\tkzgr@nstyle](#1)%
                      [\cmdGR@vertex@position]{%
        \noexpand\tkzgr@vertex@Label}}%
       \@tempa;}{%
        \protected@edef\@tempa{%
        \noexpand\node[outer sep=0pt,\cmdGR@vertex@style,\tkzgr@nstyle](#1)
                       at (\cmdGR@vertex@a:\cmdGR@vertex@d){%
        \noexpand\tkzgr@vertex@Label}}%
        \@tempa;}}{%
    \protected@edef\@tempa{%
      \noexpand\node[outer sep=0pt,\cmdGR@vertex@style,\tkzgr@nstyle](#1)
                 at (\cmdGR@vertex@x,\cmdGR@vertex@y){%
      \noexpand\tkzgr@vertex@Label}}%
      \@tempa;}%
  \end{scope}
\fi%
}
